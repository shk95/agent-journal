[Unit]
Description=Check and apply Agent Journal server releases
Wants=network-online.target
Requires=agent-journal-recover.service
After=network-online.target agent-journal-recover.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/agent-journal/server_deploy.py update
TimeoutStartSec=30min
